{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "types": [],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@gi-tcg/core/data": [
        "./genius-invokation/packages/custom-data-loader/dist/gts/data.d.ts"
      ],
      "@gi-tcg/custom-data-loader/gts/*": [
        "./genius-invokation/packages/custom-data-loader/dist/gts/*"
      ]
    },
    "tsBuildInfoFile": "./node_modules/tsconfig.tsbuildinfo",
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}